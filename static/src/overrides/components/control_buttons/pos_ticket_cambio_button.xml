<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_ticket_cambio.TicketCambioButton" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//t[@t-if='props.showRemainingButtons']/div/OrderlineNoteButton" position="after">
            <button t-att-class="buttonClass" t-on-click="() => this.clickTagNumber()">
                <t t-if="pos.get_order().cantidad_tickets_cambio &gt; 0">
                    <i class='fa fa-file' /> <t t-esc="pos.get_order().cantidad_tickets_cambio" />
                </t>
                <t t-if="!pos.get_order().cantidad_tickets_cambio">
                    <i class='fa fa-file' /> Cantidad de Cambios
                </t>
            </button>
        </xpath>
    </t>

</templates>
